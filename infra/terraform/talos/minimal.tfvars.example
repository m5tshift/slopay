# Minimal stand (SRS 6.4). Copy to terraform.tfvars (kept out of Git) and edit.
# VM names match infra/terraform/hyperv/minimal.tfvars.example.

cluster_name       = "weigate"
talos_version      = "v1.x.y"
kubernetes_version = "1.x.y"

# Static addresses in the subnet of the Hyper-V external switch, outside the router DHCP range.
nodes = {
  "talos-cp-1" = { role = "controlplane", ip = "192.0.2.11" }
  "talos-w-1"  = { role = "worker", ip = "192.0.2.12" }
}
prefixlen    = 24
gateway      = "192.0.2.1"
dns          = "192.0.2.1"
install_disk = "/dev/sda"

# kubeconfig-admin and talosconfig are written here: outside the repository.
config_dir = "~/.weigate"
