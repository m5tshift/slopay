# Full stand (SRS 6.1). Copy to terraform.tfvars (kept out of Git) and edit.
# winrm_host and winrm_password are set only in the untracked *.tfvars file:
#   winrm_host     = "<name or address of the stand PC>"
#   winrm_password = "<password of the WinRM account>"

net_adapter_name = "Ethernet"

vms = {
  "talos-cp-1" = { vcpu = 2, ram_gb = 4, disks = [20], mac = "020000000001" }
  "talos-w-1"  = { vcpu = 3, ram_gb = 7, disks = [20, 50], mac = "020000000002" }
  "talos-w-2"  = { vcpu = 3, ram_gb = 7, disks = [20, 50], mac = "020000000003" }
  "talos-w-3"  = { vcpu = 3, ram_gb = 7, disks = [20, 50], mac = "020000000004" }
  "lb-1"       = { vcpu = 1, ram_gb = 0.5, disks = [8], mac = "020000000005" }
  "lb-2"       = { vcpu = 1, ram_gb = 0.5, disks = [8], mac = "020000000006" }
}

# ISO of the Talos nodes comes from the talos layer: iso_urls.auto.tfvars.json (see runbook, step 1).
# ISO of the VMs outside the talos layer is set by hand.
extra_iso_urls = {
  "lb-1" = "https://cdimage.debian.org/cdimage/archive/13.7.0/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso"
  "lb-2" = "https://cdimage.debian.org/cdimage/archive/13.7.0/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso"
}

# Checksums by URL (checked after the download).
iso_sha256 = {
  "https://cdimage.debian.org/cdimage/archive/13.7.0/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso" = "A7EF94AC2FB9A7FEC454552ABD629B7CC9D5155C886165A45649F5CE6167E355"
}
