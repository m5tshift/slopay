# Minimal stand (SRS 6.4). Copy to terraform.tfvars (kept out of Git) and edit.
# winrm_host and winrm_password are set only in the untracked *.tfvars file:
#   winrm_host     = "<name or address of the stand PC>"
#   winrm_password = "<password of the WinRM account>"

net_adapter_name = "Ethernet"

vms = {
  "talos-cp-1" = { vcpu = 2, ram_gb = 3, disks = [20], mac = "020000000001" }
  "talos-w-1"  = { vcpu = 6, ram_gb = 14, disks = [20, 50], mac = "020000000002" }
}

# iso_urls (per-node Image Factory ISO, ADR 0008) is not set here: the talos layer writes it to
# iso_urls.auto.tfvars.json (see runbook, step 1).
