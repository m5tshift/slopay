# Full stand (SRS 6.3): manages <cluster>-vault-admin Secrets for all 3 CNPG clusters and seeds all KV v2 secrets.
openbao_addr               = "http://127.0.0.1:8200"
manage_vault_admin_secrets = true
kubeconfig_path            = "/path/to/kubeconfig-admin"
seed_kv_secrets            = true
# Optional secrets passed via environment (never committed):
#   TF_VAR_telegram_bot_token, TF_VAR_telegram_chat_id, TF_VAR_github_token, TF_VAR_anvil_mnemonic, TF_VAR_payer_keys

postgres_clusters = {
  merchant-pg = {
    host         = "merchant-pg-rw.data.svc"
    database     = "merchant"
    static_roles = { merchant-service = "merchant-service" }
  }
  invoice-pg = {
    host         = "invoice-pg-rw.data.svc"
    database     = "invoice"
    static_roles = { invoice-service = "invoice-service" }
  }
  ledger-pg = {
    host         = "ledger-pg-rw.data.svc"
    database     = "ledger"
    static_roles = { ledger-service = "ledger-service" }
  }
}
