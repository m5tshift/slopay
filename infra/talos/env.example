# Copy to ./env (ignored by git) and edit. Sourced by gen.sh.
# VM names match infra/terraform/hyperv/minimal.tfvars.example: talos-cp-1, talos-w-1.

CLUSTER_NAME=slopay

# Static addresses of the nodes (same subnet as the Hyper-V external switch).
CP_IP=192.0.2.11
W_IP=192.0.2.12
PREFIXLEN=24
GATEWAY=192.0.2.1
DNS=192.0.2.1

# Disk Talos is installed on (the 20 GB system disk of each VM).
# Check on a booted node: talosctl get disks --insecure -n <ip>
INSTALL_DISK=/dev/sda

# Versions of the Talos ISO the VMs were booted from and the Kubernetes to install.
# Example: TALOS_VERSION=v1.x.y, K8S_VERSION=1.x.y
TALOS_VERSION=CHANGE_ME
K8S_VERSION=CHANGE_ME

# Optional: installer image from Image Factory (factory.talos.dev/installer/<schematic>:<version>).
# Leave empty to use the default installer image of TALOS_VERSION.
INSTALL_IMAGE=
