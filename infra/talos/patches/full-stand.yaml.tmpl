# Machine config patch for every node of the full stand. Rendered by infra/terraform/talos (templatefile).
# Cilium replaces flannel and kube-proxy (SRS INF-1.1a); Zot is the registry mirror (SRS INF-1.4),
# one path per upstream: /v2/<host>, plus direct HTTP mirror for in-cluster images (zot.registry.svc:5000).
# Endpoints list all workers' NodePort 30500 so containerd survives losing any single worker.
cluster:
  network:
    cni:
      name: none
  proxy:
    disabled: true
machine:
  registries:
    mirrors:
      "zot.registry.svc:5000":
        endpoints:
%{ for ep in zot_endpoints ~}
          - ${ep}
%{ endfor ~}
%{ for host in mirror_hosts ~}
      ${host}:
        endpoints:
%{ for ep in zot_endpoints ~}
          - ${ep}/v2/${host}
%{ endfor ~}
        overridePath: true
%{ endfor ~}
