# Machine config patch for talos-cp-1. Rendered by infra/terraform/talos (templatefile).
# Network stays at the Talos default: flannel and kube-proxy (SRS 6.4).
# Workloads are not scheduled on the control plane (allowSchedulingOnControlPlanes stays false).
machine:
  install:
    disk: ${install_disk}
    image: ${install_image}
  network:
    hostname: ${hostname}
    nameservers:
      - ${dns}
    interfaces:
      - deviceSelector:
          physical: true
        dhcp: false
        addresses:
          - ${ip}/${prefixlen}
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
