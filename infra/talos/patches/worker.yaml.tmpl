# Machine config patch for talos-w-1. Rendered by gen.sh (envsubst).
machine:
  install:
    disk: ${INSTALL_DISK}
  network:
    hostname: talos-w-1
    nameservers:
      - ${DNS}
    interfaces:
      - deviceSelector:
          physical: true
        dhcp: false
        addresses:
          - ${W_IP}/${PREFIXLEN}
        routes:
          - network: 0.0.0.0/0
            gateway: ${GATEWAY}
