# Generated by the Ansible role strimzi (weigate, infra/ansible/roles/strimzi). Do not edit.
# Profile {{ strimzi_profile }}. Address for services: {{ strimzi_cluster_name }}-kafka-bootstrap.{{ strimzi_namespace }}.svc:9092 (plain, no TLS, no authentication).
apiVersion: kafka.strimzi.io/v1
kind: Kafka
metadata:
  name: {{ strimzi_cluster_name }}
  namespace: {{ strimzi_namespace }}
spec:
  kafka:
    version: {{ strimzi_kafka_version }}
    listeners:
      - name: plain
        port: 9092
        type: internal
        tls: false
    config:
      auto.create.topics.enable: false
      default.replication.factor: {{ strimzi_p.replication_factor }}
      min.insync.replicas: {{ strimzi_p.min_isr }}
      offsets.topic.replication.factor: {{ strimzi_p.replication_factor }}
      transaction.state.log.replication.factor: {{ strimzi_p.replication_factor }}
      transaction.state.log.min.isr: {{ strimzi_p.min_isr }}
    metricsConfig:
      type: jmxPrometheusExporter
      valueFrom:
        configMapKeyRef:
          name: kafka-metrics
          key: kafka-metrics-config.yml
  kafkaExporter:
    topicRegex: ".*"
    groupRegex: ".*"
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 128Mi
  entityOperator:
    topicOperator:
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
        limits:
          cpu: 500m
          memory: 256Mi
