# Generated by the Ansible role strimzi (weigate, infra/ansible/roles/strimzi). Do not edit.
# Topics of SRS 4.1.5, profile {{ strimzi_profile }}.
{% for t in strimzi_selected_topics %}
---
apiVersion: kafka.strimzi.io/v1
kind: KafkaTopic
metadata:
  name: {{ t.name | replace('.', '-') }}
  namespace: {{ strimzi_namespace }}
  labels:
    strimzi.io/cluster: {{ strimzi_cluster_name }}
spec:
  topicName: {{ t.name }}
  partitions: {{ t.partitions }}
  replicas: {{ strimzi_p.replication_factor }}
  config:
{% if t.compact %}
    cleanup.policy: compact
{% else %}
    cleanup.policy: delete
    retention.ms: {{ strimzi_retention_ms }}
{% endif %}
{% endfor %}
