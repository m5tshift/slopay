{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/m5tshift/slopay/main/contracts/schemas/rate.tick.v1.json",
  "title": "rate.tick",
  "description": "A quote from one source (SRS 4.1.3, 4.1.5). Key and subject: <source>:<pair>, so the order is kept within a source. Goes to ClickHouse as the rate history.",
  "allOf": [{ "$ref": "cloudevent.v1.json" }],
  "properties": {
    "type": { "const": "rate.tick" },
    "source": { "const": "/slopay/rate-service" },
    "subject": {
      "description": "<source>:<pair>, equals the Kafka key.",
      "type": "string",
      "pattern": "^(coinbase:(ETH-USD|USDT-USD)|okx:ETH-USDT)$"
    },
    "dataschema": { "const": "https://raw.githubusercontent.com/m5tshift/slopay/main/contracts/schemas/rate.tick.v1.json" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pair", "price", "quotedAt"],
      "properties": {
        "source": { "enum": ["coinbase", "okx"] },
        "pair": { "enum": ["ETH-USD", "ETH-USDT", "USDT-USD"] },
        "price": {
          "description": "Quote: units of the quote currency for one whole unit of the base currency, a decimal string. For okx:ETH-USDT it is not yet converted to USD.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "quotedAt": {
          "description": "When the source quoted the price.",
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "okx" } } },
          "then": { "properties": { "pair": { "const": "ETH-USDT" } } },
          "else": { "properties": { "pair": { "enum": ["ETH-USD", "USDT-USD"] } } }
        }
      ]
    }
  }
}
