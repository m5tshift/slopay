{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/m5tshift/slopay/main/contracts/schemas/invoice.paid.v1.json",
  "title": "invoice.paid",
  "description": "N confirmations, the received sum is within the tolerance. transfers lists every accounted transfer.",
  "allOf": [{ "$ref": "cloudevent.v1.json" }],
  "properties": {
    "type": { "const": "invoice.paid" },
    "source": { "const": "/slopay/invoice-service" },
    "subject": { "$ref": "defs.v1.json#/definitions/uuid" },
    "dataschema": { "const": "https://raw.githubusercontent.com/m5tshift/slopay/main/contracts/schemas/invoice.paid.v1.json" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoiceId", "merchantId", "sequence", "status", "address", "asset", "amount", "received", "overpaid", "confirmations", "transfers", "paidAt"],
      "properties": {
        "invoiceId": { "$ref": "defs.v1.json#/definitions/uuid" },
        "merchantId": { "$ref": "defs.v1.json#/definitions/uuid" },
        "sequence": { "$ref": "defs.v1.json#/definitions/sequence" },
        "status": { "const": "PAID" },
        "address": { "$ref": "defs.v1.json#/definitions/address" },
        "asset": { "$ref": "defs.v1.json#/definitions/asset" },
        "amount": { "$ref": "defs.v1.json#/definitions/positiveAmount" },
        "received": { "$ref": "defs.v1.json#/definitions/amount" },
        "overpaid": {
          "description": "Received more than the invoice amount.",
          "type": "boolean"
        },
        "confirmations": { "$ref": "defs.v1.json#/definitions/confirmations" },
        "transfers": { "$ref": "defs.v1.json#/definitions/accountedTransfers" },
        "paidAt": {
          "description": "Timestamp of the block on which the invoice became PAID (chain time). The address tracking window ends 24 h after the later of expiresAt and paidAt.",
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
