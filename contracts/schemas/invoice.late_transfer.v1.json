{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/m5tshift/weigate/main/contracts/schemas/invoice.late_transfer.v1.json",
  "title": "invoice.late_transfer",
  "description": "A transfer with N confirmations to the address of an invoice in a final status (PAID, LATE_PAID, UNDERPAID after expiresAt) within the tracking window. The status does not change.",
  "allOf": [{ "$ref": "cloudevent.v1.json" }],
  "properties": {
    "type": { "const": "invoice.late_transfer" },
    "source": { "const": "/weigate/invoice-service" },
    "subject": { "$ref": "defs.v1.json#/definitions/uuid" },
    "dataschema": { "const": "https://raw.githubusercontent.com/m5tshift/weigate/main/contracts/schemas/invoice.late_transfer.v1.json" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoiceId", "merchantId", "sequence", "status", "address", "asset", "amount", "transfers"],
      "properties": {
        "invoiceId": { "$ref": "defs.v1.json#/definitions/uuid" },
        "merchantId": { "$ref": "defs.v1.json#/definitions/uuid" },
        "sequence": { "$ref": "defs.v1.json#/definitions/sequence" },
        "status": { "enum": ["PAID", "LATE_PAID", "UNDERPAID"] },
        "address": { "$ref": "defs.v1.json#/definitions/address" },
        "asset": { "$ref": "defs.v1.json#/definitions/asset" },
        "amount": { "$ref": "defs.v1.json#/definitions/positiveAmount" },
        "transfers": {
          "description": "Late transfers, each with N confirmations.",
          "allOf": [{ "$ref": "defs.v1.json#/definitions/accountedTransfers" }]
        }
      }
    }
  }
}
