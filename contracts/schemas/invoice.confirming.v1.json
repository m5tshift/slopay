{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/m5tshift/weigate/main/contracts/schemas/invoice.confirming.v1.json",
  "title": "invoice.confirming",
  "description": "The latest accounted transfer has 2..N-1 confirmations, or an additional payment returned an UNDERPAID invoice before expiresAt.",
  "allOf": [{ "$ref": "cloudevent.v1.json" }],
  "properties": {
    "type": { "const": "invoice.confirming" },
    "source": { "const": "/weigate/invoice-service" },
    "subject": { "$ref": "defs.v1.json#/definitions/uuid" },
    "dataschema": { "const": "https://raw.githubusercontent.com/m5tshift/weigate/main/contracts/schemas/invoice.confirming.v1.json" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoiceId", "merchantId", "sequence", "status", "address", "asset", "amount", "received", "confirmations"],
      "properties": {
        "invoiceId": { "$ref": "defs.v1.json#/definitions/uuid" },
        "merchantId": { "$ref": "defs.v1.json#/definitions/uuid" },
        "sequence": { "$ref": "defs.v1.json#/definitions/sequence" },
        "status": { "const": "CONFIRMING" },
        "address": { "$ref": "defs.v1.json#/definitions/address" },
        "asset": { "$ref": "defs.v1.json#/definitions/asset" },
        "amount": { "$ref": "defs.v1.json#/definitions/positiveAmount" },
        "received": { "$ref": "defs.v1.json#/definitions/amount" },
        "confirmations": { "$ref": "defs.v1.json#/definitions/confirmations" }
      }
    }
  }
}
